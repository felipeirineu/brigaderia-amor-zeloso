{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "brigaderia-amor-zeloso-local",
  "main": "index.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "vars": { "PUBLIC_CATALOG_ENABLED": "false" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brigaderia-local",
      "database_id": "local-only-phase-0",
      "migrations_dir": "../database/migrations",
    },
  ],
}
