{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brigaderia-amor-zeloso",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-30",
  "vars": {
    "PUBLIC_CATALOG_ENABLED": "false",
    "FINANCE_ENABLED": "true",
    "P1_ENABLED": "true",
    "P1_TOOLS_ENABLED": "true",
    "MOBILE_ENABLED": "true",
    "FIELD_ENABLED": "true",
    "OPERATIONS_ENABLED": "true",
    "ACCESS_TEAM_DOMAIN": "amorzeloso.cloudflareaccess.com",
    "ACCESS_AUD": "94aae0721b3546d008d3dfc8fd9fbc4c3688308832e269dd5692581c27e0187c",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brigaderia-amor-zeloso-homologacao",
      "database_id": "7dbe82ad-7dc7-4373-8817-b55ad95a979a",
      "migrations_dir": "database/migrations",
    },
  ],
}
