{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brigaderia-amor-zeloso",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-30",
  "vars": {
    "PUBLIC_CATALOG_ENABLED": "false",
    "ACCESS_TEAM_DOMAIN": "TODO-CONFIRMAR.cloudflareaccess.com",
    "ACCESS_AUD": "TODO-CONFIRMAR",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "TODO-CONFIRMAR",
      "database_id": "TODO-CONFIRMAR",
      "migrations_dir": "database/migrations",
    },
  ],
}
