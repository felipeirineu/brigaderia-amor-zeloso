{
  "name": "brigaderia-amor-zeloso-gestao",
  "private": true,
  "version": "0.14.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:migrations": "python3 tests/integration/migrations.py",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc --local --ip 127.0.0.1",
    "db:migrate:local": "wrangler d1 migrations apply brigaderia-local --config worker/wrangler.jsonc --local",
    "build:pages": "npm run build && node scripts/build-pages.mjs",
    "preview:pages": "wrangler pages dev dist --ip 127.0.0.1",
    "test:api": "node tests/integration/management.mjs",
    "admin:prepare": "node scripts/prepare-admin.mjs",
    "test:listing": "node tests/integration/listing.mjs",
    "brand:build": "node scripts/build-brand.mjs",
    "test:brand": "node tests/integration/brand.mjs",
    "test:operations": "node tests/integration/migration-operations.mjs && node tests/integration/operations.mjs && node tests/integration/delivery-messages.mjs",
    "test:finance": "node tests/integration/finance.mjs && node tests/integration/customer-address.mjs",
    "ops:preflight": "node scripts/ops-preflight.mjs",
    "ops:restore-check": "node scripts/restore-check.mjs",
    "test:r2": "node tests/integration/migration-r2.mjs && node tests/integration/review-r2.mjs",
    "test:p1": "node tests/integration/planning.mjs && node tests/integration/reports.mjs && node tests/integration/mixed-reports.mjs && node tests/integration/expenses.mjs && node tests/integration/recipes.mjs && node tests/integration/mixed-costs.mjs",
    "test:mobile": "node tests/integration/mobile.mjs",
    "test:field": "node tests/integration/field.mjs && node tests/integration/profile-photos.mjs",
    "test:inventory": "node tests/integration/inventory.mjs",
    "test:import": "node tests/integration/customer-import.mjs",
    "test:backup": "node tests/integration/backup.mjs",
    "test:workday": "node tests/integration/workday.mjs",
    "test:routing": "node tests/integration/routing.mjs",
    "test:mixed": "node tests/integration/mixed.mjs && node tests/integration/recurring-mixed.mjs",
    "test:prospects": "node tests/integration/prospects.mjs",
    "test:security": "node tests/integration/security.mjs",
    "test:cleanup": "node tests/integration/clean-test-data.mjs",
    "test:push": "node tests/integration/push.mjs && node tests/integration/push-failures.mjs",
    "test:weight-costing": "node tests/integration/weight-costing.mjs",
    "test:kits": "node tests/integration/kits.mjs && node tests/integration/kit-order-model.mjs && node tests/integration/kit-orders.mjs && node tests/integration/kit-recurring.mjs && node tests/integration/customer-occasions.mjs && node tests/integration/kit-size-analysis.mjs && node tests/integration/flavor-only.mjs",
    "test:visits": "node tests/integration/visits.mjs"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "2.0.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "fflate": "^0.8.3",
    "jose": "^6.2.15",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "read-excel-file": "^9.3.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "miniflare": "^5.20261023.3-beta",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
