{
  "name": "brigaderia-amor-zeloso-gestao",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:migrations": "python3 tests/integration/migrations.py",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc --local --ip 127.0.0.1",
    "db:migrate:local": "wrangler d1 migrations apply brigaderia-local --config worker/wrangler.jsonc --local",
    "build:pages": "npm run build && node scripts/build-pages.mjs",
    "preview:pages": "wrangler pages dev dist --ip 127.0.0.1",
    "test:api": "node tests/integration/management.mjs",
    "admin:prepare": "node scripts/prepare-admin.mjs",
    "test:listing": "node tests/integration/listing.mjs"
  },
  "dependencies": {
    "jose": "^6.2.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261031.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "miniflare": "^5.20261023.3-beta",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
